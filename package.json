{
  "name": "liveflow",
  "version": "0.1.0",
  "description": "Testa o fluxo de tela de cada card ou branch, de forma determinística, antes de entregar.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": { "liveflow": "bin/liveflow.js" },
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "liveflow": "node src/cli.ts"
  },
  "dependencies": { "yaml": "^2.9.1" },
  "devDependencies": { "@types/node": "^22", "typescript": "^5.9.3" }
}
